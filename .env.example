# Copy to .env for local use. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Leave empty locally to use SQLite. On a host, use the PostgreSQL URL it gives you.
# (Neon / Supabase URLs usually need ?sslmode=require at the end.)
DATABASE_URL=

# Optional: only needed if you run Celery workers
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/1

# Optional: custom domain
EXTRA_ALLOWED_HOSTS=
CSRF_EXTRA_ORIGINS=

DEMO_CUSTOMERS=1500
